{
  "name": "remote-code",
  "version": "0.0.1",
  "description": "Run a fleet of Claude Code agents on your PC, controlled from your phone via Telegram. Session-aware, quota-aware, multi-agent.",
  "type": "module",
  "license": "MIT",
  "author": "Karolis Paulikas <kpaulikas21@gmail.com>",
  "repository": "github:Karolis332/remote-code",
  "bin": {
    "remote-code": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --target node20 --clean --dts",
    "build:bin": "bun build src/index.ts --compile --outfile dist/remote-code",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "telegraf": "^4.16.3",
    "better-sqlite3": "^12.4.1",
    "zod": "^4.4.1",
    "execa": "^9.7.0",
    "pino": "^9.13.0",
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "@types/node": "^20.18.5",
    "@types/better-sqlite3": "^7.6.13",
    "typescript": "^5.9.4",
    "tsx": "^4.20.5",
    "tsup": "^8.5.0",
    "vitest": "^3.2.4",
    "eslint": "^9.40.0"
  },
  "engines": {
    "node": ">=20"
  }
}
