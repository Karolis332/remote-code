# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram chat IDs allowed to control this daemon.
# Get yours by messaging @userinfobot on Telegram.
ALLOWED_CHAT_IDS=

# Optional: pairing code shown on first run. If unset, one is generated.
PAIRING_CODE=

# Path to Claude Code CLI binary. Default: searches PATH.
CLAUDE_BIN=claude

# SQLite db path. Default: ~/.remotecode/state.db
REMOTECODE_DB=

# Log level: trace|debug|info|warn|error
LOG_LEVEL=info
