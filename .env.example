# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram chat IDs allowed to control this daemon.
# Get yours by messaging @userinfobot on Telegram.
ALLOWED_CHAT_IDS=

# Optional: pairing code shown on first run. If unset, one is generated.
PAIRING_CODE=

# Path to Claude Code CLI binary. Default: searches PATH.
CLAUDE_BIN=claude

# SQLite db path. Default: ~/.remotecode/state.db
REMOTECODE_DB=

# Log level: trace|debug|info|warn|error
LOG_LEVEL=info

# Natural-language router. Choose one provider; leave the other blank.
#   NLP_PROVIDER=anthropic  (Claude Haiku, default)
#   NLP_PROVIDER=openai     (gpt-4o-mini)
# If neither key is set, the router is disabled and only slash commands work.
NLP_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional: override the model. Defaults: claude-haiku-4-5-20251001 / gpt-4o-mini.
NLP_MODEL=
